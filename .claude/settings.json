{
  "permissions": {
    "allow": [
      "Bash(uv run --extra dev pytest)",
      "Bash(uv run --extra dev pytest *)",
      "Bash(uv run ruff check *)",
      "Bash(uv run --extra dev ruff check *)",
      "Bash(uv run pre-commit run *)",
      "Bash(uv run labrador *)",
      "Bash(uv run python scripts/check_model.py)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "deny": [
      "Edit(~/.labrador/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.sh", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ruff_edited.sh", "timeout": 30 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/tests_on_stop.sh", "timeout": 180, "statusMessage": "Running pytest" }
        ]
      }
    ]
  }
}
